generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  INVITATION_REJECTED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_STATUS_CHANGED
  COMMENT_ADDED
}

model User {
  id                     Int     @id @default(autoincrement())
  username               String  @unique
  email                  String  @unique
  passwordHash           String
  profilePictureUrl      String?
  profilePicturePublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings                UserSettings?
  ownedProjects           Project[]       @relation("ProjectOwner")
  memberships             ProjectMember[]
  sentInvitations         Invitation[]    @relation("InvitationSender")
  receivedInvitations     Invitation[]    @relation("InvitationReceiver")
  createdTasks            Task[]          @relation("TaskCreator")
  taskAssignees           TaskAssignee[]  @relation("TaskAssigneeUser")
  assignedTaskAssignments TaskAssignee[]  @relation("TaskAssigneeBy")
  comments                Comment[]
  activities              Activity[]
  uploadedAttachments     Attachment[]    @relation("AttachmentUploader")
  notifications           Notification[]
}

model UserSettings {
  id                   Int     @id @default(autoincrement())
  userId               Int     @unique
  theme                String  @default("system")
  emailNotifications   Boolean @default(true)
  taskNotifications    Boolean @default(true)
  commentNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  ownerId     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members       ProjectMember[]
  invitations   Invitation[]
  tasks         Task[]
  activities    Activity[]
  notifications Notification[]

  @@index([ownerId])
}

model ProjectMember {
  id        Int         @id @default(autoincrement())
  projectId Int
  userId    Int
  role      ProjectRole
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Invitation {
  id            Int              @id @default(autoincrement())
  projectId     Int
  invitedUserId Int
  invitedById   Int
  role          ProjectRole
  status        InvitationStatus @default(PENDING)

  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  invitedUser User @relation("InvitationReceiver", fields: [invitedUserId], references: [id], onDelete: Cascade)

  invitedBy User @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@index([invitedUserId, status])
  @@index([projectId, status])
  @@index([expiresAt])
}

model Task {
  id          Int          @id @default(autoincrement())
  projectId   Int
  createdById Int
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  deadline    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdBy User @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  assignees     TaskAssignee[]
  comments      Comment[]
  activities    Activity[]
  attachments   Attachment[]
  notifications Notification[]

  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([deadline])
}

model TaskAssignee {
  id           Int      @id @default(autoincrement())
  taskId       Int
  userId       Int
  assignedById Int
  assignedAt   DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User @relation("TaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User @relation("TaskAssigneeBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([taskId, userId])
  @@index([userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  message   String   @db.VarChar(5000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([userId])
}

model Activity {
  id        Int      @id @default(autoincrement())
  projectId Int
  taskId    Int?
  userId    Int
  action    String   @db.VarChar(100)
  metadata  Json?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([userId, createdAt])
}

model Attachment {
  id              Int      @id @default(autoincrement())
  taskId          Int
  uploadedById    Int
  fileName        String   @db.VarChar(255)
  fileUrl         String   @db.Text
  fileType        String   @db.VarChar(100)
  fileSize        Int
  storageProvider String   @default("CLOUDINARY")
  storagePublicId String   @unique
  createdAt       DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([uploadedById])
}

model Notification {
  id           Int              @id @default(autoincrement())
  userId       Int
  type         NotificationType
  message      String           @db.VarChar(500)
  projectId    Int?
  taskId       Int?
  invitationId Int?
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([projectId])
  @@index([taskId])
  @@index([invitationId])
}
